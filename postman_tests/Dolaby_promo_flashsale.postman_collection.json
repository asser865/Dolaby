{
	"info": {
		"name": "Dolaby_promo_flashsale",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "E2E: Promo Kill Switch",
			"item": [
				{
					"name": "1. Customer Logs In",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "email", "value": "ahmed@dolaby.com", "type": "text" },
								{ "key": "password", "value": "pass123", "type": "text" }
							]
						},
						"url": "http://localhost/dolaby_v2_SQA/php/login.php"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Customer Login Successful\", function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }]
				},
				{
					"name": "2. Customer Validates Promo (Should Work)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "promo_code", "value": "WELCOME10", "type": "text" },
								{ "key": "order_amount", "value": "500", "type": "text" }
							]
						},
						"url": "http://localhost/dolaby_v2_SQA/php/validate_promo.php"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Promo code is VALID for customer\", function () { pm.expect(pm.response.json().valid).to.be.true; });"], "type": "text/javascript" } }]
				},
				{
					"name": "3. Brand Owner Logs In",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "email", "value": "owner@harbaa.com", "type": "text" },
								{ "key": "password", "value": "pass123", "type": "text" }
							]
						},
						"url": "http://localhost/dolaby_v2_SQA/php/brandowner_login.php"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Brand Owner Login Successful\", function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }]
				},
				{
					"name": "4. Brand Owner Kills Promo",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"promo_id\": 1,\n    \"status\": \"inactive\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "http://localhost/dolaby_v2_SQA/api/brandowner/toggle_promo.php"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Promo was successfully killed\", function () { pm.expect(pm.response.json().success).to.be.true; });"], "type": "text/javascript" } }]
				},
				{
					"name": "5. Customer Tries Again (Should Fail)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "promo_code", "value": "WELCOME10", "type": "text" },
								{ "key": "order_amount", "value": "500", "type": "text" }
							]
						},
						"url": "http://localhost/dolaby_v2_SQA/php/validate_promo.php"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Promo code is now INVALID for customer\", function () { pm.expect(pm.response.json().valid).to.be.false; });"], "type": "text/javascript" } }]
				},
				{
					"name": "6. Brand Owner Restores Promo (Reset for next test)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"promo_id\": 1,\n    \"status\": \"active\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "http://localhost/dolaby_v2_SQA/api/brandowner/toggle_promo.php"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Promo successfully restored for next run\", function () { pm.expect(pm.response.json().success).to.be.true; });"], "type": "text/javascript" } }]
				}
			]
		},
		{
			"name": "E2E: Flash Sale Price Drop",
			"item": [
				{
					"name": "1. Brand Owner Drops Price to 499",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"product_id\": 1,\n    \"new_price\": 499.00,\n    \"original_price\": 699.00\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "http://localhost/dolaby_v2_SQA/api/brandowner/update_price.php"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Price updated successfully\", function () { pm.expect(pm.response.json().success).to.be.true; });"], "type": "text/javascript" } }]
				},
				{
					"name": "2. Customer Sees New Price",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost/dolaby_v2_SQA/api/get_product.php?id=1"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Customer sees dropped price (499)\", function () { var data = pm.response.json().data; pm.expect(data.price).to.eql(499); pm.expect(data.on_sale).to.eql(1); });"], "type": "text/javascript" } }]
				},
				{
					"name": "3. Brand Owner Restores Price to 699 (Reset)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"product_id\": 1,\n    \"new_price\": 699.00,\n    \"original_price\": null\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "http://localhost/dolaby_v2_SQA/api/brandowner/update_price.php"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Price reverted successfully\", function () { pm.expect(pm.response.json().success).to.be.true; });"], "type": "text/javascript" } }]
				},
				{
					"name": "4. Customer Sees Normal Price Again",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost/dolaby_v2_SQA/api/get_product.php?id=1"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test(\"Customer sees normal price (699)\", function () { var data = pm.response.json().data; pm.expect(data.price).to.eql(699); pm.expect(data.on_sale).to.eql(0); });"], "type": "text/javascript" } }]
				}
			]
		}
	]
}
